<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DylansApp"
        tools:targetApi="31">
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/title_activity_about"
            android:theme="@style/Theme.DylansApp" />
        <activity
            android:name=".ElementsActivity"
            android:exported="false"
            android:label="@string/title_activity_elements"
            android:theme="@style/Theme.DylansApp" />
        <activity
            android:name=".PoniesActivity"
            android:exported="false"
            android:label="@string/title_activity_ponies"
            android:theme="@style/Theme.DylansApp" />
        <activity
            android:name=".DylanActivity"
            android:exported="false"
            android:label="@string/title_activity_about_dylan"
            android:theme="@style/Theme.DylansApp" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DylansApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>